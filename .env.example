# QuantOS remote database operations target the hosted Supabase PostgreSQL instance.
# Copy into `.env` or `.env.local` only for non-production or controlled operator environments.

# Required for all remote database commands:
# - make db-apply
# - make db-reset
# - make db-schema-diff
# - make rls-policy-test
# Backend workers require session semantics for leases and transactions. Use
# the Supabase session-pooler port (5432), not transaction-pooler port 6543.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Remote cross-region Auth live-test ceiling. Co-located production remains <100ms.
QUANTOS_AUTH_READ_P95_LIMIT_MS=500

# Remote cross-region Runtime scheduling ceiling. Same-region production SLO remains <200ms.
QUANTOS_RUNTIME_SCHEDULE_P95_LIMIT_MS=1500

# Per-process append-only trace export. Use a distinct durable path for each
# deployed service/Engine replica. The optional address exposes health,
# Prometheus metrics, correlation trace queries, and structured errors.
QUANTOS_TRACE_EXPORT_PATH=artifacts/observability/service-traces.jsonl
QUANTOS_OBSERVABILITY_ADDR=127.0.0.1:9090

# F09 scheduled capacity monitor output. Persist this path and run
# `make f09-capacity-snapshot` once per minute in production/pre-production.
QUANTOS_F09_EVIDENCE_PATH=artifacts/observability/f09-alerts.json

# Destructive reset guard for `make db-reset`.
# Leave empty by default. Set to `reset_remote_schema` only for an intentional reset run.
QUANTOS_DB_RESET_CONFIRM=

# Supabase Storage settings for F05 artifact persistence tests.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_STORAGE_BUCKET=quantos-artifacts
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_AUTH_TOKEN=

# Live integration test gates. Leave disabled unless the backing services are available.
QUANTOS_RUN_SUPABASE_STORAGE_TESTS=0

# Optional and privileged: required only while provisioning or verifying the
# TP01 controlled fork branch protections. Use a fine-grained token scoped to
# sumalphai/Vibe-Trading with Administration: read/write and Contents: write.
# Never commit the real value; GitHub Actions uses the same secret name.
TP01_FORK_ADMIN_TOKEN=
