{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantOS Terminal",
  "version": "0.1.0",
  "identifier": "ai.sumalpha.quantos",
  "build": {
    "beforeDevCommand": "pnpm --filter @sumalpha/terminal dev",
    "beforeBuildCommand": "pnpm --filter @sumalpha/terminal build",
    "devUrl": "http://localhost:3100",
    "frontendDist": "../terminal/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuantOS Terminal",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3100 https://app.sumalpha.ai; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["quantos"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
