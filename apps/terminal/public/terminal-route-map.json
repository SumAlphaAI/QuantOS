{
  "schema": "quantos-terminal-static-routes/v1",
  "routes": [
    {
      "prefix": "strategies",
      "document": "strategies.html",
      "parameter": "strategyId",
      "suffix": "lab"
    },
    {
      "prefix": "audit",
      "document": "audit.html",
      "parameter": "correlationId"
    },
    {
      "prefix": "exports",
      "document": "exports.html",
      "parameter": "exportId"
    },
    {
      "prefix": "data-snapshots",
      "document": "data-snapshots.html",
      "parameter": "snapshotId"
    },
    {
      "prefix": "research",
      "document": "research.html",
      "parameter": "runId"
    },
    {
      "prefix": "artifacts",
      "document": "artifacts.html",
      "parameter": "artifactId"
    },
    {
      "prefix": "backtests",
      "document": "backtests.html",
      "parameter": "runId"
    },
    {
      "prefix": "releases",
      "document": "releases.html",
      "parameter": "releaseId"
    },
    {
      "prefix": "markets",
      "document": "markets.html",
      "parameter": "symbol"
    },
    {
      "prefix": "risk",
      "document": "risk.html",
      "parameter": "ruleId",
      "suffix": "rules"
    },
    {
      "prefix": "proposals",
      "document": "proposals.html",
      "parameter": "proposalId"
    },
    {
      "prefix": "approvals",
      "document": "approvals.html",
      "parameter": "approvalId"
    },
    {
      "prefix": "orders",
      "document": "orders.html",
      "parameter": "orderId"
    },
    {
      "prefix": "trade",
      "document": "trade.html",
      "parameter": "symbol"
    },
    {
      "prefix": "reconciliation",
      "document": "reconciliation.html",
      "parameter": "runId"
    },
    {
      "prefix": "markets",
      "document": "markets/chart.html",
      "parameter": "symbol",
      "suffix": "chart"
    }
  ],
  "resourcePattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
  "targetHostingAcceptance": "NOT_RUN"
}
