{
  "schema": "quantos-terminal-static-routes/v1",
  "routes": [
    {
      "prefix": "audit",
      "document": "audit.html",
      "parameter": "correlationId"
    },
    {
      "prefix": "exports",
      "document": "exports.html",
      "parameter": "exportId"
    },
    {
      "prefix": "data-snapshots",
      "document": "data-snapshots.html",
      "parameter": "snapshotId"
    },
    {
      "prefix": "research",
      "document": "research.html",
      "parameter": "runId"
    }
  ],
  "resourcePattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
  "targetHostingAcceptance": "NOT_RUN"
}
