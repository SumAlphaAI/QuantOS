  "nodes": {
    "CORE:F01": {
      "scope": "Pinned tools, dependency inventories and reproducible development configuration; final release signatures/remote rebuild excluded",
      "inputs": [
        "rust-toolchain.toml",
        ".nvmrc",
        "pnpm-workspace.yaml",
        "scripts/check-f01.mjs",
        "scripts/f01-*",
        "scripts/check-toolchains.mjs",
        "engines/pyproject.toml",
        "engines/uv.lock",
        "apps/*/package.json",
        "packages/*/package.json",
        "crates/*/Cargo.toml",
        "engines/build-constraints.txt",
        ".python-version",
        "crates/*/README.md",
        "services/*/README.md",
        "packages/*/README.md",
        "apps/terminal/README.md",
        "apps/website/README.md",
        "proto/README.md",
        "crates/README.md",
        "services/README.md",
        "engines/README.md",
        "apps/README.md",
        "packages/README.md",
        "supabase/README.md",
        "engines/*/README.md",
        ".uv-version",
        "services/*/Cargo.toml",
        "engines/*/pyproject.toml",
        "tools/*/Cargo.toml"
      ],
      "checks": [
        "f01",
        "f01-negative"
      ]
    },
    "CORE:F03": {
      "scope": "Proto/schema generation, compatibility and current TS client interop",
      "inputs": [
        "proto/",
        "buf.yaml",
        "buf.gen.yaml",
        "buf.lock",
        "crates/quantos-proto/",
        "packages/api-client/",
        "scripts/*proto*",
        "scripts/*json-schema*",
        "scripts/tests/*proto*",
        "scripts/tests/*json-schema*",
        "tools/proto-json-codegen/",
        "engines/engine-sdk/"
      ],
      "checks": [
        "proto",
        "proto-client",
        "api-client-tests"
      ]
    },
    "CORE:F04": {
      "scope": "Deterministic domain primitives and fixture corpus correctness",
      "inputs": [
        "crates/quantos-core/",
        "crates/quantos-testkit/",
        "scripts/*f04*"
      ],
      "checks": [
        "foundation-rust",
        "f04",
        "f04-negative"
      ]
    },
    "CORE:F05": {
      "scope": "Event integrity, tenant isolation, append-only audit and bounded receipt/lease recovery on configured Supabase; volume/soak excluded",
      "inputs": [
        "crates/quantos-event/",
        "services/replay-cli/",
        "supabase/migrations/20260921090000_f05_ledger_integrity_and_replay.sql",
        "scripts/*f05*",
        "docs/runbooks/f05_db_polling_consumer_recovery.md"
      ],
      "checks": [
        "event-rust",
        "f05",
        "f05-negative",
        "f05-database"
      ]
    },
    "CORE:F06": {
      "scope": "Identity/roles, real Auth/BFF/Runtime, execution/Vault and PostgreSQL denial correctness; latency benchmark excluded",
      "inputs": [
        "crates/quantos-auth/",
        "crates/quantos-policy/",
        "services/bff-gateway/",
        "services/runtime-gateway/",
        "services/execution-gateway/",
        "scripts/*f06*",
        "scripts/run-p0-f06-target.mjs",
        "supabase/migrations/"
      ],
      "checks": [
        "auth-rust",
        "f06-negative",
        "f06-target"
      ]
    },
    "FE:PRE-01": {
      "scope": "Phase-one route/API owner register and traceability",
      "inputs": [
        "docs/PRE-01-page-api-coverage-register.md",
        "scripts/check-pre01.mjs",
        "scripts/tests/check-pre01.test.mjs",
        "bff/page-operation-catalog.yaml",
        "docs/PRE-01-page-ledger-and-stories.md",
        "docs/PRE-01-route-permission-matrix.md",
        "docs/PRE-01-requirements-baseline.json"
      ],
      "checks": [
        "pre01",
        "pre01-negative"
      ]
    },
    "FE:PRE-02": {
      "scope": "Design tokens, components, accessibility and design consistency baseline",
      "inputs": [
        "packages/ui/",
        "docs/PRE-02*"
      ],
      "checks": [
        "pre02",
        "pre02-negative",
        "ui-tests"
      ]
    },
    "FE:PRE-03": {
      "scope": "Web runtime/architecture PoCs, real compiled exports and browser rendering; Desktop excluded",
      "inputs": [
        "apps/terminal/",
        "apps/website/",
        "packages/platform/",
        "packages/config/",
        "scripts/pre03*",
        "scripts/capture-build*",
        "scripts/runtime*",
        "scripts/webpack*",
        "docs/adr/20260814-pre03-runtime-stack.md"
      ],
      "checks": [
        "build-terminal",
        "build-website",
        "storybook",
        "pre03",
        "pre03-negative"
      ]
    },
    "FE:PRE-04": {
      "scope": "Domain fields and trusted session mapping, decimal/int64/time/enum correctness",
      "inputs": [
        "docs/PRE-04*",
        "scripts/pre04*",
        "packages/api-client/",
        "packages/domain-ui/"
      ],
      "checks": [
        "pre04",
        "pre04-negative",
        "api-client-tests",
        "domain-ui-tests"
      ]
    },
    "FE:PRE-05": {
      "scope": "Environment separation, mock profile and credential containment",
      "inputs": [
        "packages/config/",
        "scripts/pre05*",
        "scripts/check-client-secrets.mjs"
      ],
      "checks": [
        "pre05",
        "pre05-negative",
        "config-tests"
      ]
    },
    "FE:PRE-06": {
      "scope": "Schema/mock/provider fixtures, negative harness, registered visual and critical branch baseline",
      "inputs": [
        "tests/contract/",
        "tests/critical-branches.json",
        "scripts/*pre06*",
        "scripts/check-visual-baselines.mjs",
        "packages/api-client/",
        "packages/domain-ui/",
        "packages/ui/",
        "vitest.coverage.config.ts",
        "vitest.critical.config.ts"
      ],
      "checks": [
        "pre06",
        "pre06-negative",
        "schema",
        "generated",
        "catalog",
        "visual-inventory",
        "sabotage",
        "critical"
      ]
    },
    "PREPARATION:P0": {
      "scope": "All six preparation functional standards/PoCs and basic Chromium regression; full platform matrix/performance release evidence excluded",
      "inputs": [
        "playwright.config.ts",
        "tests/e2e/"
      ],
      "checks": [
        "plans",
        "plans-negative",
        "chromium",
        "coverage"
      ]
    },
    "FE:BFF-FE-000": {
      "scope": "OpenAPI/generated client/schema, semantic safety and frozen published/planned operation baseline",
      "inputs": [
        "bff/",
        "packages/api-client/",
        "tests/contract/",
        "scripts/*bff*",
        "docs/BFF-FE-000-openapi-proposal.md",
        "docs/PRE-01-page-api-coverage-register.md"
      ],
      "checks": [
        "a1",
        "openapi",
        "generated",
        "catalog",
        "compatibility",
        "a1-negative",
        "client-typecheck",
        "client-lint",
        "api-client-tests",
        "schema"
      ]
    },
    "PROVIDER:A1": {
      "scope": "A1 contracts/schema/security and implemented C01/C17/C10 reference provider/consumer harness; live browser CORS configuration; future providers excluded",
      "inputs": [
        "services/bff-gateway/",
        "apps/terminal/src/auth/",
        "apps/terminal/src/settings/",
        "apps/terminal/src/audit/",
        "apps/terminal/tests/",
        "packages/api-client/",
        "tests/contract/",
        "scripts/test-bff-provider-contract.mjs",
        "scripts/test-provider-a1-mutations.mjs",
        "scripts/f09-target-gate.cjs",
        "scripts/check-provider-a1-db-visibility.mjs"
      ],
      "checks": [
        "provider-rust",
        "provider-http",
        "semantic-mutations",
        "receipt-negative",
        "db-visibility"
      ]
    }
  },
  "developmentProfile": {
    "file": "env/local-mock.env.example",
    "overrides": {
      "NEXT_PUBLIC_QUANTOS_TERMINAL_ORIGIN": "http://localhost:3190",
      "NEXT_PUBLIC_QUANTOS_OIDC_REDIRECT_URI": "http://localhost:3190/auth/callback"
    }
  }
