      "command": [
        "pnpm",
        "test:browser",
        "--project=chromium",
        "--workers=2",
        "--retries=0",
        "--update-snapshots=none"
      ],
      "marker": "passed"
    },
    "provider-rust": {
      "command": [
        "cargo",
        "test",
        "--locked",
        "--offline",
        "-p",
        "bff-gateway",
        "--lib",
        "--tests"
      ],
      "marker": "test result: ok"
    },
    "provider-http": {
      "command": [
        "node",
        "scripts/test-bff-provider-contract.mjs"
      ],
      "marker": "\"status\":\"PASS\"",
      "output": "reference-http.json"
    },
