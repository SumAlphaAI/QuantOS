{
  "schema": "quantos-provider-a1-functional-policy/v1",
  "excluded": [
    "RELEASE staging deployment",
    "RELEASE seven-role authorization/signatures",
    "RELEASE same-SHA hosted CI",
    "RELEASE performance/soak/full platform matrix",
    "unimplemented A2-A6 providers",
    "P16 Desktop"
  ],
  "commonInputs": [
    "scripts/provider-a1-receipts.mjs",
    "scripts/provider-a1-policy.json",
    "scripts/provider-a1-receipts.test.mjs",
    "Cargo.toml",
    "Cargo.lock",
    "package.json",
    "pnpm-lock.yaml",
    "Makefile",
    ".github/workflows/ci.yml",
    ".github/workflows/frontend-baseline.yml",
    ".gitattributes",
    "scripts/",
    ".github/workflows/",
    "env/",
    "tsconfig.base.json",
    "eslint.config.mjs"
  ],
  "checks": {
    "f01": {
      "command": [
        "node",
        "scripts/check-f01.mjs"
      ]
    },
    "f01-negative": {
      "command": [
        "node",
        "--test",
        "scripts/f01-gate-negative.mjs"
      ],
      "marker": "fail 0"
    },
    "proto": {
      "command": [
        "bash",
        "scripts/check-proto.sh"
      ],
      "marker": "Proto checks passed"
    },
    "proto-client": {
      "command": [
        "make",
        "proto-compat-check"
      ]
    },
    "f04": {
      "command": [
        "node",
        "scripts/check-f04.mjs"
      ]
    },
    "f04-negative": {
      "command": [
        "node",
        "--test",
        "scripts/f04-gate-negative.mjs"
      ],
      "marker": "fail 0"
    },
    "foundation-rust": {
      "command": [
        "cargo",
        "test",
        "--locked",
        "--offline",
        "-p",
        "quantos-core",
        "-p",
        "quantos-testkit",
        "--lib"
      ],
      "marker": "test result: ok"
    },
    "f05": {
      "command": [
        "node",
        "scripts/check-f05.mjs"
      ]
    },
    "f05-negative": {
      "command": [
        "node",
        "--test",
        "scripts/f05-gate-negative.mjs"
      ],
      "marker": "fail 0"
