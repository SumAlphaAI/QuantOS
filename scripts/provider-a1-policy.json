        "--locked",
        "--offline",
        "-p",
        "quantos-event",
        "--lib"
      ],
      "marker": "test result: ok"
    },
    "f05-database": {
      "command": [
        "cargo",
        "test",
        "-p",
        "quantos-event",
        "--test",
        "postgres_persistence",
        "--locked",
        "--offline",
        "--",
        "--test-threads=1",
        "--skip",
        "postgres_ten_thousand_event_chain_is_lossless_and_eventually_consistent",
        "--skip",
        "postgres_connection_failures_are_closed_for_plain_and_tls_clients",
        "--skip",
        "postgres_tls_root_configuration_fails_closed"
      ],
      "marker": "8 passed; 0 failed",
      "database": true
    },
    "auth-rust": {
      "command": [
        "cargo",
        "test",
        "--locked",
        "--offline",
        "-p",
        "quantos-auth",
        "--lib"
      ],
      "marker": "test result: ok"
    },
    "f06-negative": {
      "command": [
        "node",
        "--test",
        "scripts/f06-acceptance-gate-negative.mjs",
        "scripts/f06-http-budget.test.cjs"
