        "--filter",
        "@sumalpha/terminal",
        "build"
      ],
      "marker": "next build"
    },
    "web-oidc-poc": {
      "command": [
        "pnpm",
        "exec",
        "playwright",
        "test",
        "tests/e2e/auth-callback.spec.ts",
        "tests/e2e/command.spec.ts",
        "--project=chromium",
        "--retries=0"
      ],
      "marker": "11 passed"
    },
