{
  "name": "@sumalpha/quantos",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "proto:generate": "pnpm exec buf generate && node ./scripts/extract-json-schemas.mjs",
    "proto:check": "bash ./scripts/check-proto.sh",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "coverage:web": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:browser": "playwright test --config playwright.config.ts",
    "build": "pnpm -r build",
    "smoke:pre03": "node scripts/pre03-smoke.mjs",
    "test:contract": "vitest run tests/contract",
    "check:perf": "node scripts/check-perf-budget.mjs",
    "sabotage:pre06": "node scripts/pre06-sabotage-check.mjs",
    "check:bff-openapi": "node scripts/check-bff-openapi.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protobuf": "2.13.0",
    "@eslint/js": "9.33.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "24.3.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "3.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "license-checker-rseidelsohn": "4.4.2",
    "msw": "^2.15.0",
    "pg": "8.16.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "3.2.4",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "playwright": ">=1.55.1",
      "@playwright/test": ">=1.55.1",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18",
      "nanoid": ">=3.3.18"
    }
  }
}
