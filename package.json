{
  "name": "@sumalpha/quantos",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "proto:deps:update": "buf dep update",
    "proto:generate": "bash ./scripts/generate-proto.sh",
    "proto:check": "make proto-check",
    "generate:bff": "node ./scripts/generate-bff-contracts.mjs",
    "check:bff-generated": "node ./scripts/check-bff-generated.mjs",
    "check:bff-contract-coverage": "node ./scripts/check-bff-contract-coverage.mjs",
    "check:bff-fe-000": "node scripts/check-bff-fe-000.mjs",
    "test:bff-fe-000": "node --test scripts/bff-fe-000-gate-negative.mjs",
    "check:bff-fe-001": "node scripts/check-bff-fe-001.mjs",
    "test:bff-fe-001": "node --test scripts/bff-fe-001-gate-negative.mjs && node scripts/test-bff-fe-001-mutations.mjs && node --test scripts/f09-migration-ledger.test.cjs",
    "check:bff-fe-007": "node scripts/check-bff-fe-007.mjs",
    "test:bff-fe-007": "node --test scripts/bff-fe-007-gate-negative.mjs",
    "test:tauri-deep-link": "cargo test --manifest-path apps/terminal-desktop/src-tauri/Cargo.toml --lib",
    "check:g0-records": "node ./scripts/check-g0-records.mjs",
    "check:pre01": "node ./scripts/check-pre01.mjs",
    "test:pre01": "node --test ./scripts/tests/check-pre01.test.mjs",
    "check:pre02": "pnpm --filter @sumalpha/ui check:design",
    "test:pre02": "pnpm --filter @sumalpha/ui test:pre02",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "coverage:web": "vitest run --config vitest.coverage.config.ts --coverage && pnpm coverage:critical",
    "test:browser": "node scripts/check-pre06.mjs && playwright test --config playwright.config.ts",
    "test:browser:website": "node scripts/check-pre06.mjs && playwright test --config playwright.website.config.ts",
    "build": "pnpm -r build",
    "check:pre03": "node scripts/pre03-smoke.mjs",
    "check:pre03:web": "node scripts/pre03-smoke.mjs --web-only",
    "test:pre03": "node --test scripts/pre03-gate-negative.mjs",
    "smoke:pre03": "node scripts/pre03-smoke.mjs",
    "generate:pre04-fields": "node scripts/pre04-render-fields.mjs",
    "check:pre04": "node scripts/pre04-inventory.mjs",
    "test:pre04": "node --test scripts/pre04-gate-negative.mjs",
    "check:pre05": "pnpm --filter @sumalpha/config check:env",
    "test:pre05": "pnpm --filter @sumalpha/config test && node --test scripts/pre05-gate-negative.mjs",
    "test:contract": "node scripts/check-pre06.mjs && vitest run tests/contract",
    "check:pre06": "node scripts/check-pre06.mjs",
    "test:pre06": "node --test scripts/pre06-gate-negative.mjs scripts/pre06-runtime-negative.mjs",
    "check:visual-baselines": "node scripts/check-visual-baselines.mjs",
    "check:perf": "node scripts/check-perf-budget.mjs",
    "sabotage:pre06": "node scripts/pre06-sabotage-check.mjs",
    "check:bff-openapi": "node scripts/check-bff-openapi.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "check:development-plans": "node scripts/check-development-plans.mjs",
    "test:development-plans": "node --test scripts/development-plan-order-negative.mjs",
    "check:pre03:desktop": "node scripts/pre03-smoke.mjs --desktop",
    "test:pre03:desktop": "node --test scripts/pre03-desktop-negative.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs apps/website/out apps/terminal/out",
    "coverage:critical": "vitest run --config vitest.critical.config.ts --coverage",
    "check:p0": "node scripts/check-p0-acceptance.mjs",
    "test:p0": "node --test scripts/p0-acceptance-negative.mjs",
    "check:bff-compatibility": "node scripts/check-bff-compatibility.mjs",
    "test:bff-remediation": "node --test scripts/bff-remediation-negative.mjs && vitest run tests/contract/bff-remediation.test.ts packages/api-client/tests/sse-safety.test.ts",
    "check:bff-a1-acceptance": "node scripts/check-bff-a1-acceptance.mjs",
    "test:bff-provider-contract": "node scripts/test-bff-provider-contract.mjs",
    "check:bff-a1-development": "node scripts/check-bff-a1-acceptance.mjs --stage development",
    "check:bff-a1-final-review": "node scripts/check-bff-a1-acceptance.mjs --stage final-review",
    "check:provider-a1": "node scripts/provider-a1-receipts.mjs",
    "assess:provider-a1": "node scripts/provider-a1-receipts.mjs --assess",
    "test:provider-a1": "node --test scripts/provider-a1-receipts.test.mjs"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protobuf": "2.13.0",
    "@eslint/js": "9.33.0",
    "@next/eslint-plugin-next": "15.5.24",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "license-checker-rseidelsohn": "4.4.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "4.1.11",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "playwright": "1.62.1",
      "@playwright/test": "1.62.1",
      "playwright-core": "1.62.1",
      "sharp": "0.35.4",
      "postcss": ">=8.5.18",
      "nanoid": ">=3.3.18",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "js-yaml@4": "4.3.2",
      "fast-uri@3": "3.1.8",
      "uuid@9": "11.1.1",
      "brace-expansion@5": "5.0.12"
    }
  }
}
