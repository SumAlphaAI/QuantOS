{
  "name": "@sumalpha/quantos",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "proto:generate": "pnpm exec buf generate && node ./scripts/extract-json-schemas.mjs",
    "proto:check": "bash ./scripts/check-proto.sh",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "coverage:web": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:browser": "playwright test --config playwright.config.ts",
    "build": "pnpm -r build",
    "smoke:pre03": "node scripts/pre03-smoke.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protobuf": "2.13.0",
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.54.2",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "license-checker-rseidelsohn": "4.4.2",
    "pg": "8.16.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "3.2.4"
  }
}
