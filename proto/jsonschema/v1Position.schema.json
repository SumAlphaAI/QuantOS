{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1Position.schema.json",
  "title": "v1Position",
  "type": "object",
  "properties": {
    "metadata": {
      "$ref": "#/definitions/v1CommandMetadata"
    },
    "position_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "side": {
      "$ref": "#/definitions/v1PositionSide"
    },
    "quantity": {
      "$ref": "#/definitions/v1DecimalValue"
    },
    "average_entry_price": {
      "$ref": "#/definitions/v1DecimalValue"
    },
    "mark_value": {
      "$ref": "#/definitions/v1MoneyValue"
    },
    "unrealized_pnl": {
      "$ref": "#/definitions/v1MoneyValue"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "metadata",
    "position_id",
    "account_id",
    "symbol",
    "side",
    "quantity",
    "average_entry_price",
    "as_of"
  ],
  "definitions": {
    "v1MoneyValue": {
      "type": "object",
      "properties": {
        "currency_code": {
          "type": "string"
        },
        "units": {
          "type": "string",
          "format": "int64"
        },
        "nanos": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "currency_code",
        "units",
        "nanos"
      ]
    },
    "v1DecimalValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "v1PositionSide": {
      "type": "string",
      "enum": [
        "POSITION_SIDE_UNSPECIFIED",
        "POSITION_SIDE_NET",
        "POSITION_SIDE_LONG",
        "POSITION_SIDE_SHORT"
      ],
      "default": "POSITION_SIDE_UNSPECIFIED"
    },
    "v1CommandMetadata": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/definitions/v1ActorRef"
        },
        "correlation_id": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/v1RuntimeMode"
        },
        "environment": {
          "$ref": "#/definitions/v1Environment"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "workspace_id",
        "actor",
        "correlation_id",
        "mode",
        "environment",
        "issued_at"
      ]
    },
    "v1Environment": {
      "type": "string",
      "enum": [
        "ENVIRONMENT_UNSPECIFIED",
        "ENVIRONMENT_LOCAL",
        "ENVIRONMENT_TEST",
        "ENVIRONMENT_STAGING",
        "ENVIRONMENT_PRODUCTION"
      ],
      "default": "ENVIRONMENT_UNSPECIFIED"
    },
    "v1RuntimeMode": {
      "type": "string",
      "enum": [
        "RUNTIME_MODE_UNSPECIFIED",
        "RUNTIME_MODE_RESEARCH",
        "RUNTIME_MODE_PAPER",
        "RUNTIME_MODE_SHADOW",
        "RUNTIME_MODE_ASSISTED_LIVE",
        "RUNTIME_MODE_GUARDED_LIVE"
      ],
      "default": "RUNTIME_MODE_UNSPECIFIED"
    },
    "v1ActorRef": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_kind": {
          "$ref": "#/definitions/v1ActorKind"
        },
        "display_name": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actor_id",
        "actor_kind"
      ]
    },
    "v1ActorKind": {
      "type": "string",
      "enum": [
        "ACTOR_KIND_UNSPECIFIED",
        "ACTOR_KIND_USER",
        "ACTOR_KIND_SERVICE",
        "ACTOR_KIND_AUTOMATION"
      ],
      "default": "ACTOR_KIND_UNSPECIFIED"
    }
  }
}
