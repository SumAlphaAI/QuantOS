{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1CommandMetadata.schema.json",
  "title": "v1CommandMetadata",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "actor": {
      "$ref": "#/definitions/v1ActorRef"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "mode": {
      "$ref": "#/definitions/v1RuntimeMode"
    },
    "environment": {
      "$ref": "#/definitions/v1Environment"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "request_id",
    "tenant_id",
    "workspace_id",
    "actor",
    "correlation_id",
    "mode",
    "environment",
    "issued_at"
