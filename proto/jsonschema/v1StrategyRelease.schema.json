{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1StrategyRelease.schema.json",
  "title": "v1StrategyRelease",
  "type": "object",
  "properties": {
    "metadata": {
      "$ref": "#/definitions/v1CommandMetadata"
    },
    "release_id": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "source_digest": {
      "type": "string"
    },
    "image_digest": {
      "type": "string"
    },
    "parameter_hash": {
      "type": "string"
    },
    "backtest_report_artifact_id": {
      "type": "string"
    },
    "data_snapshot_id": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/v1EvidenceRef"
      }
    },
    "allowed_targets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/v1DeploymentTarget"
      }
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "metadata",
    "release_id",
    "strategy_id",
    "name",
    "source_digest",
    "image_digest",
    "parameter_hash",
    "backtest_report_artifact_id",
    "data_snapshot_id",
    "allowed_targets",
    "created_at"
  ],
  "definitions": {
    "v1DeploymentTarget": {
      "type": "string",
      "enum": [
        "DEPLOYMENT_TARGET_UNSPECIFIED",
        "DEPLOYMENT_TARGET_RESEARCH",
        "DEPLOYMENT_TARGET_PAPER",
        "DEPLOYMENT_TARGET_SHADOW",
        "DEPLOYMENT_TARGET_ASSISTED_LIVE"
      ],
      "default": "DEPLOYMENT_TARGET_UNSPECIFIED"
    },
    "v1EvidenceRef": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "artifact_id",
        "summary"
      ]
    },
    "v1CommandMetadata": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/definitions/v1ActorRef"
        },
        "correlation_id": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/v1RuntimeMode"
        },
        "environment": {
          "$ref": "#/definitions/v1Environment"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "workspace_id",
        "actor",
        "correlation_id",
        "mode",
        "environment",
        "issued_at"
      ]
    },
    "v1Environment": {
      "type": "string",
      "enum": [
        "ENVIRONMENT_UNSPECIFIED",
        "ENVIRONMENT_LOCAL",
        "ENVIRONMENT_TEST",
        "ENVIRONMENT_STAGING",
        "ENVIRONMENT_PRODUCTION"
      ],
      "default": "ENVIRONMENT_UNSPECIFIED"
    },
    "v1RuntimeMode": {
      "type": "string",
      "enum": [
        "RUNTIME_MODE_UNSPECIFIED",
        "RUNTIME_MODE_RESEARCH",
        "RUNTIME_MODE_PAPER",
        "RUNTIME_MODE_SHADOW",
        "RUNTIME_MODE_ASSISTED_LIVE",
        "RUNTIME_MODE_GUARDED_LIVE"
      ],
      "default": "RUNTIME_MODE_UNSPECIFIED"
    },
    "v1ActorRef": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_kind": {
          "$ref": "#/definitions/v1ActorKind"
        },
        "display_name": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actor_id",
        "actor_kind"
      ]
    },
    "v1ActorKind": {
      "type": "string",
      "enum": [
        "ACTOR_KIND_UNSPECIFIED",
        "ACTOR_KIND_USER",
        "ACTOR_KIND_SERVICE",
        "ACTOR_KIND_AUTOMATION"
      ],
      "default": "ACTOR_KIND_UNSPECIFIED"
    }
  }
}
