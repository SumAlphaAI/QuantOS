{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1DataSnapshot.schema.json",
  "title": "v1DataSnapshot",
  "type": "object",
  "properties": {
    "metadata": {
      "$ref": "#/definitions/v1CommandMetadata"
    },
    "snapshot_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "window": {
      "$ref": "#/definitions/v1TimeWindow"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/definitions/v1DataSourceRef"
      }
    },
    "quality": {
      "$ref": "#/definitions/v1DataQuality"
    },
    "content_hash": {
      "type": "string"
    },
    "license_label": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_age": {
      "type": "string"
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/definitions/v1ArtifactRef"
      }
    }
  },
  "required": [
    "metadata",
    "snapshot_id",
    "schema_version",
    "window",
    "sources",
    "quality",
    "content_hash",
    "license_label",
    "captured_at",
    "max_age"
  ],
  "definitions": {
    "v1ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "classification": {
          "$ref": "#/definitions/v1DataClassification"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "media_type",
        "sha256",
        "classification"
      ]
    },
    "v1DataClassification": {
      "type": "string",
      "enum": [
        "DATA_CLASSIFICATION_UNSPECIFIED",
        "DATA_CLASSIFICATION_PUBLIC",
        "DATA_CLASSIFICATION_INTERNAL",
        "DATA_CLASSIFICATION_CONFIDENTIAL",
        "DATA_CLASSIFICATION_RESTRICTED"
      ],
      "default": "DATA_CLASSIFICATION_UNSPECIFIED"
    },
    "v1DataQuality": {
      "type": "string",
      "enum": [
        "DATA_QUALITY_UNSPECIFIED",
        "DATA_QUALITY_PENDING",
        "DATA_QUALITY_PASSED",
        "DATA_QUALITY_DEGRADED",
        "DATA_QUALITY_FAILED"
      ],
      "default": "DATA_QUALITY_UNSPECIFIED"
    },
    "v1DataSourceRef": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        },
        "license_label": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "provider",
        "dataset",
        "license_label"
      ]
    },
    "v1TimeWindow": {
      "type": "object",
      "properties": {
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start_at",
        "end_at"
      ]
    },
    "v1CommandMetadata": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/definitions/v1ActorRef"
        },
        "correlation_id": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/v1RuntimeMode"
        },
        "environment": {
          "$ref": "#/definitions/v1Environment"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "workspace_id",
        "actor",
        "correlation_id",
        "mode",
        "environment",
        "issued_at"
      ]
    },
    "v1Environment": {
      "type": "string",
      "enum": [
        "ENVIRONMENT_UNSPECIFIED",
        "ENVIRONMENT_LOCAL",
        "ENVIRONMENT_TEST",
        "ENVIRONMENT_STAGING",
        "ENVIRONMENT_PRODUCTION"
      ],
      "default": "ENVIRONMENT_UNSPECIFIED"
    },
    "v1RuntimeMode": {
      "type": "string",
      "enum": [
        "RUNTIME_MODE_UNSPECIFIED",
        "RUNTIME_MODE_RESEARCH",
        "RUNTIME_MODE_PAPER",
        "RUNTIME_MODE_SHADOW",
        "RUNTIME_MODE_ASSISTED_LIVE",
        "RUNTIME_MODE_GUARDED_LIVE"
      ],
      "default": "RUNTIME_MODE_UNSPECIFIED"
    },
    "v1ActorRef": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_kind": {
          "$ref": "#/definitions/v1ActorKind"
        },
        "display_name": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actor_id",
        "actor_kind"
      ]
    },
    "v1ActorKind": {
      "type": "string",
      "enum": [
        "ACTOR_KIND_UNSPECIFIED",
        "ACTOR_KIND_USER",
        "ACTOR_KIND_SERVICE",
        "ACTOR_KIND_AUTOMATION"
      ],
      "default": "ACTOR_KIND_UNSPECIFIED"
    }
  }
}
