{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1ActorRef.schema.json",
  "title": "v1ActorRef",
  "type": "object",
  "properties": {
    "actor_id": {
      "type": "string"
    },
    "actor_kind": {
      "$ref": "#/definitions/v1ActorKind"
    },
    "display_name": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "actor_id",
    "actor_kind"
  ],
  "definitions": {
    "v1ActorKind": {
      "type": "string",
      "enum": [
        "ACTOR_KIND_UNSPECIFIED",
        "ACTOR_KIND_USER",
        "ACTOR_KIND_SERVICE",
        "ACTOR_KIND_AUTOMATION"
      ],
      "default": "ACTOR_KIND_UNSPECIFIED"
    }
  }
}
