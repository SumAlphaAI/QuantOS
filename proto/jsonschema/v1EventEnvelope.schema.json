{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1EventEnvelope.schema.json",
  "title": "v1EventEnvelope",
  "type": "object",
  "properties": {
    "metadata": {
