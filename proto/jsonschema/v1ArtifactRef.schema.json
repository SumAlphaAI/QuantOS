{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1ArtifactRef.schema.json",
  "title": "v1ArtifactRef",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "uri": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "classification": {
      "$ref": "#/definitions/v1DataClassification"
    }
  },
  "required": [
    "artifact_id",
    "uri",
    "media_type",
    "sha256",
    "classification"
  ],
  "definitions": {
    "v1DataClassification": {
      "type": "string",
      "enum": [
        "DATA_CLASSIFICATION_UNSPECIFIED",
        "DATA_CLASSIFICATION_PUBLIC",
        "DATA_CLASSIFICATION_INTERNAL",
        "DATA_CLASSIFICATION_CONFIDENTIAL",
        "DATA_CLASSIFICATION_RESTRICTED"
      ],
      "default": "DATA_CLASSIFICATION_UNSPECIFIED"
    }
  }
}
