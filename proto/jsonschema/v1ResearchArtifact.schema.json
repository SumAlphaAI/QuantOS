{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1ResearchArtifact.schema.json",
  "title": "v1ResearchArtifact",
  "type": "object",
  "properties": {
    "metadata": {
      "$ref": "#/definitions/v1CommandMetadata"
    },
    "artifact_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "code_version": {
      "type": "string"
    },
    "environment_hash": {
      "type": "string"
    },
    "data_snapshot_id": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/definitions/v1EvidenceRef"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/definitions/v1ArtifactRef"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit_tags": {
      "$ref": "#/definitions/v1AuditTags"
    }
  },
  "required": [
    "metadata",
    "artifact_id",
    "title",
    "hypothesis",
    "summary",
    "content_hash",
    "engine_version",
    "prompt_version",
    "code_version",
    "environment_hash",
    "data_snapshot_id",
    "created_at"
  ],
  "definitions": {
    "v1AuditTags": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "v1ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "classification": {
          "$ref": "#/definitions/v1DataClassification"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "media_type",
        "sha256",
        "classification"
      ]
    },
    "v1DataClassification": {
      "type": "string",
      "enum": [
        "DATA_CLASSIFICATION_UNSPECIFIED",
        "DATA_CLASSIFICATION_PUBLIC",
        "DATA_CLASSIFICATION_INTERNAL",
        "DATA_CLASSIFICATION_CONFIDENTIAL",
        "DATA_CLASSIFICATION_RESTRICTED"
      ],
      "default": "DATA_CLASSIFICATION_UNSPECIFIED"
    },
    "v1EvidenceRef": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "artifact_id",
        "summary"
      ]
    },
    "v1CommandMetadata": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/definitions/v1ActorRef"
        },
        "correlation_id": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/v1RuntimeMode"
        },
        "environment": {
          "$ref": "#/definitions/v1Environment"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "workspace_id",
        "actor",
        "correlation_id",
        "mode",
        "environment",
        "issued_at"
      ]
    },
    "v1Environment": {
      "type": "string",
      "enum": [
        "ENVIRONMENT_UNSPECIFIED",
        "ENVIRONMENT_LOCAL",
        "ENVIRONMENT_TEST",
        "ENVIRONMENT_STAGING",
        "ENVIRONMENT_PRODUCTION"
      ],
      "default": "ENVIRONMENT_UNSPECIFIED"
    },
    "v1RuntimeMode": {
      "type": "string",
      "enum": [
        "RUNTIME_MODE_UNSPECIFIED",
        "RUNTIME_MODE_RESEARCH",
        "RUNTIME_MODE_PAPER",
        "RUNTIME_MODE_SHADOW",
        "RUNTIME_MODE_ASSISTED_LIVE",
        "RUNTIME_MODE_GUARDED_LIVE"
      ],
      "default": "RUNTIME_MODE_UNSPECIFIED"
    },
    "v1ActorRef": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_kind": {
          "$ref": "#/definitions/v1ActorKind"
        },
        "display_name": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actor_id",
        "actor_kind"
      ]
    },
    "v1ActorKind": {
      "type": "string",
      "enum": [
        "ACTOR_KIND_UNSPECIFIED",
        "ACTOR_KIND_USER",
        "ACTOR_KIND_SERVICE",
        "ACTOR_KIND_AUTOMATION"
      ],
      "default": "ACTOR_KIND_UNSPECIFIED"
    }
  }
}
