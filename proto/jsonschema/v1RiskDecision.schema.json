{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1RiskDecision.schema.json",
  "title": "v1RiskDecision",
  "type": "object",
  "properties": {
    "metadata": {
      "$ref": "#/definitions/v1CommandMetadata"
    },
    "decision_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "verdict": {
      "$ref": "#/definitions/v1RiskVerdict"
    },
    "hit_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signer": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "metadata",
    "decision_id",
    "proposal_id",
    "verdict",
    "hit_rules",
    "signer",
    "reason",
    "decided_at"
  ],
  "definitions": {
    "v1RiskVerdict": {
      "type": "string",
      "enum": [
        "RISK_VERDICT_UNSPECIFIED",
        "RISK_VERDICT_ALLOW",
        "RISK_VERDICT_DENY",
        "RISK_VERDICT_APPROVAL_REQUIRED"
      ],
      "default": "RISK_VERDICT_UNSPECIFIED"
    },
    "v1CommandMetadata": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/definitions/v1ActorRef"
        },
        "correlation_id": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/v1RuntimeMode"
        },
        "environment": {
          "$ref": "#/definitions/v1Environment"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "workspace_id",
        "actor",
        "correlation_id",
        "mode",
        "environment",
        "issued_at"
      ]
    },
    "v1Environment": {
      "type": "string",
      "enum": [
        "ENVIRONMENT_UNSPECIFIED",
        "ENVIRONMENT_LOCAL",
        "ENVIRONMENT_TEST",
        "ENVIRONMENT_STAGING",
        "ENVIRONMENT_PRODUCTION"
      ],
      "default": "ENVIRONMENT_UNSPECIFIED"
    },
    "v1RuntimeMode": {
      "type": "string",
      "enum": [
        "RUNTIME_MODE_UNSPECIFIED",
        "RUNTIME_MODE_RESEARCH",
        "RUNTIME_MODE_PAPER",
        "RUNTIME_MODE_SHADOW",
        "RUNTIME_MODE_ASSISTED_LIVE",
        "RUNTIME_MODE_GUARDED_LIVE"
      ],
      "default": "RUNTIME_MODE_UNSPECIFIED"
    },
    "v1ActorRef": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_kind": {
          "$ref": "#/definitions/v1ActorKind"
        },
        "display_name": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actor_id",
        "actor_kind"
      ]
    },
    "v1ActorKind": {
      "type": "string",
      "enum": [
        "ACTOR_KIND_UNSPECIFIED",
        "ACTOR_KIND_USER",
        "ACTOR_KIND_SERVICE",
        "ACTOR_KIND_AUTOMATION"
      ],
      "default": "ACTOR_KIND_UNSPECIFIED"
    }
  }
}
