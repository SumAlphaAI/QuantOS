{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumalpha.ai/schemas/v1TradeProposal.schema.json",
  "title": "v1TradeProposal",
  "type": "object",
  "properties": {
    "metadata": {
      "$ref": "#/definitions/v1CommandMetadata"
    },
    "proposal_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "action": {
      "$ref": "#/definitions/v1ProposalAction"
    },
    "quantity": {
      "$ref": "#/definitions/v1DecimalValue"
    },
    "notional": {
      "$ref": "#/definitions/v1DecimalValue"
    },
    "limit_price": {
      "$ref": "#/definitions/v1DecimalValue"
    },
    "stop_price": {
      "$ref": "#/definitions/v1DecimalValue"
    },
    "signal": {
      "$ref": "#/definitions/v1Signal"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/definitions/v1EvidenceRef"
      }
    },
    "rationale": {
      "type": "string"
    },
    "confidence": {
      "$ref": "#/definitions/v1DecimalValue"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "executable": {
      "type": "boolean"
    },
    "counter_views": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "反方观点（R04 强制）：生成 Proposal 时必须附至少一条可证伪的对立论证。\n非破坏新增（2026-08-14，G0 未冻结项 #2，Buf breaking check 验证）。"
    }
  },
  "required": [
    "metadata",
    "proposal_id",
    "account_id",
    "symbol",
    "action",
    "quantity",
    "notional",
    "signal",
    "rationale",
    "confidence",
    "expires_at",
    "executable"
  ],
  "definitions": {
    "v1DecimalValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "v1EvidenceRef": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "artifact_id",
        "summary"
      ]
    },
    "v1Signal": {
      "type": "object",
      "properties": {
        "metadata": {
          "$ref": "#/definitions/v1CommandMetadata"
        },
        "signal_id": {
          "type": "string"
        },
        "strategy_release_id": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "direction": {
          "$ref": "#/definitions/v1SignalDirection"
        },
        "strength": {
          "$ref": "#/definitions/v1DecimalValue"
        },
        "confidence": {
          "$ref": "#/definitions/v1DecimalValue"
        },
        "diagnostics": {
          "$ref": "#/definitions/v1JsonDocument"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1EvidenceRef"
          }
        }
      },
      "required": [
        "metadata",
        "signal_id",
        "strategy_release_id",
        "symbol",
        "direction",
        "strength",
        "confidence",
        "generated_at",
        "valid_until"
      ]
    },
    "v1JsonDocument": {
      "type": "object",
      "properties": {
        "value": {
          "type": "object"
        }
      }
    },
    "v1SignalDirection": {
      "type": "string",
      "enum": [
        "SIGNAL_DIRECTION_UNSPECIFIED",
        "SIGNAL_DIRECTION_LONG",
        "SIGNAL_DIRECTION_SHORT",
        "SIGNAL_DIRECTION_FLAT"
      ],
      "default": "SIGNAL_DIRECTION_UNSPECIFIED"
    },
    "v1CommandMetadata": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/definitions/v1ActorRef"
        },
        "correlation_id": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/v1RuntimeMode"
        },
        "environment": {
          "$ref": "#/definitions/v1Environment"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "workspace_id",
        "actor",
        "correlation_id",
        "mode",
        "environment",
        "issued_at"
      ]
    },
    "v1Environment": {
      "type": "string",
      "enum": [
        "ENVIRONMENT_UNSPECIFIED",
        "ENVIRONMENT_LOCAL",
        "ENVIRONMENT_TEST",
        "ENVIRONMENT_STAGING",
        "ENVIRONMENT_PRODUCTION"
      ],
      "default": "ENVIRONMENT_UNSPECIFIED"
    },
    "v1RuntimeMode": {
      "type": "string",
      "enum": [
        "RUNTIME_MODE_UNSPECIFIED",
        "RUNTIME_MODE_RESEARCH",
        "RUNTIME_MODE_PAPER",
        "RUNTIME_MODE_SHADOW",
        "RUNTIME_MODE_ASSISTED_LIVE",
        "RUNTIME_MODE_GUARDED_LIVE"
      ],
      "default": "RUNTIME_MODE_UNSPECIFIED"
    },
    "v1ActorRef": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_kind": {
          "$ref": "#/definitions/v1ActorKind"
        },
        "display_name": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actor_id",
        "actor_kind"
      ]
    },
    "v1ActorKind": {
      "type": "string",
      "enum": [
        "ACTOR_KIND_UNSPECIFIED",
        "ACTOR_KIND_USER",
        "ACTOR_KIND_SERVICE",
        "ACTOR_KIND_AUTOMATION"
      ],
      "default": "ACTOR_KIND_UNSPECIFIED"
    },
    "v1ProposalAction": {
      "type": "string",
      "enum": [
        "PROPOSAL_ACTION_UNSPECIFIED",
        "PROPOSAL_ACTION_BUY",
        "PROPOSAL_ACTION_SELL",
        "PROPOSAL_ACTION_HOLD",
        "PROPOSAL_ACTION_REDUCE"
      ],
      "default": "PROPOSAL_ACTION_UNSPECIFIED"
    }
  }
}
