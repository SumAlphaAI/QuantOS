{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantos:tp05:data-query-response:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "response_type": {
      "const": "DataQueryResponse"
    },
    "contract_version": {
      "const": "v1"
    },
    "provider": {
      "enum": [
        "mock",
        "openbb"
      ]
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "enum": [
        "crypto.market.snapshot",
        "equity.fundamentals.snapshot",
        "macro.research.snapshot"
      ]
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow_run_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_id",
        "workspace_id",
        "actor_id",
        "workflow_run_id"
      ]
    },
    "query_text": {
      "type": "string",
      "minLength": 1
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start_at",
        "end_at"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "open": {
                "type": "string",
                "minLength": 1
              },
              "high": {
                "type": "string",
                "minLength": 1
              },
              "low": {
                "type": "string",
                "minLength": 1
              },
              "close": {
                "type": "string",
                "minLength": 1
              },
              "volume": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "symbol",
              "open",
              "high",
              "low",
              "close",
              "volume"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "market_cap": {
                "type": "string",
                "minLength": 1
              },
              "pe_ratio": {
                "type": "string",
                "minLength": 1
              },
              "eps_ttm": {
                "type": "string",
                "minLength": 1
              },
              "revenue_growth_yoy": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "symbol",
              "market_cap",
              "pe_ratio",
              "eps_ttm",
              "revenue_growth_yoy"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "series": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "series",
              "value",
              "unit"
            ]
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "dataset": {
            "type": "string",
            "minLength": 1
          },
          "license_label": {
            "type": "string",
            "minLength": 1
          },
          "data_license": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "provider",
          "dataset",
          "license_label",
          "data_license"
        ]
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "data_license": {
          "const": "synthetic-fixture-only"
        },
        "status": {
          "enum": [
            "mock_only",
            "evaluation_only"
          ]
        },
        "approved_for_production": {
          "const": false
        },
        "decision_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "data_license",
        "status",
        "approved_for_production",
        "decision_ref"
      ]
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "bounded_monotonic_ttl_lru"
        },
        "ttl_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "cache_key": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "strategy",
        "ttl_secs",
        "cache_key"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "lineage_tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixture_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "snapshot_id",
        "schema_hash",
        "content_hash",
        "artifact_hash",
        "lineage_tags",
        "fixture_digest"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intended_use": {
          "enum": [
            "research",
            "evaluation"
          ]
        },
        "trading_approved": {
          "const": false
        },
        "allowed_workflows": {
          "const": [
            "research",
            "evaluation"
          ]
        }
      },
      "required": [
        "intended_use",
        "trading_approved",
        "allowed_workflows"
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "notice_required": {
          "type": "boolean"
        }
      },
      "required": [
        "repo",
        "ref",
        "notice_required"
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_implementation": {
          "const": "quantos_deterministic_fixture"
        },
        "upstream_runtime_loaded": {
          "const": false
        },
        "tools_executed": {
          "const": false
        },
        "snapshot_bytes_resolved": {
          "const": false
        },
        "live_freshness_assessed": {
          "const": false
        }
      },
      "required": [
        "provider_implementation",
        "upstream_runtime_loaded",
        "tools_executed",
        "snapshot_bytes_resolved",
        "live_freshness_assessed"
      ]
    },
    "response_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "response_type",
    "contract_version",
    "provider",
    "query_id",
    "dataset",
    "schema_ref",
    "scope",
    "query_text",
    "symbols",
    "window",
    "records",
    "sources",
    "license",
    "cache",
    "lineage",
    "usage",
    "upstream",
    "diagnostics",
    "response_hash"
  ]
}
