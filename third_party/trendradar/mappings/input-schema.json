{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "fixture_id",
    "origin",
    "input_class",
    "theme",
    "items",
    "fixture_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "fixture_id": {
      "enum": [
        "tp09-1",
        "tp09-2",
        "tp09-3"
      ]
    },
    "origin": {
      "const": "quantos_owned_synthetic"
    },
    "input_class": {
      "enum": [
        "hot_list_aggregation",
        "rss_feed"
      ]
    },
    "theme": {
      "const": "SYNTH-THEME"
    },
    "fixture_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "url",
          "guid",
          "license_label",
          "title",
          "rank",
          "published_at"
        ],
        "properties": {
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "guid": {
            "type": [
              "string",
              "null"
            ]
          },
          "license_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
