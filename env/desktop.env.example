# QuantOS 前端环境：desktop（PRE-05）
# 用途：Tauri 桌面壳。桌面端复用上述三种部署环境之一（local-mock / local-integrated / staging），
# 本模板只定义壳层差异；业务环境变量仍按所选部署环境提供。
# dev：tauri.conf.json devUrl=http://localhost:3100（terminal dev server）
# prod：壳嵌入 apps/terminal/out（frontendDist），无需 dev server。

# 桌面壳标识（构建期注入，供 packages/platform 选择 desktop adapter）
NEXT_PUBLIC_QUANTOS_PLATFORM=desktop

# 桌面端 OIDC：系统浏览器完成认证后经深链回跳，回跳必须重新鉴权（执行计划 6.3）
NEXT_PUBLIC_QUANTOS_OIDC_REDIRECT_URI=quantos://auth/callback

# 深链 scheme（与 tauri.conf.json plugins.deep-link 一致，smoke 校验）
NEXT_PUBLIC_QUANTOS_DEEP_LINK_SCHEME=quantos

# 以下变量继承所选部署环境（示例为 local-integrated）：
NEXT_PUBLIC_QUANTOS_ENV=local-integrated
NEXT_PUBLIC_QUANTOS_MOCK_ENABLED=false
NEXT_PUBLIC_QUANTOS_BFF_ORIGIN=http://localhost:8080
NEXT_PUBLIC_QUANTOS_OIDC_ISSUER=https://your-dev-idp.example.com
NEXT_PUBLIC_QUANTOS_OIDC_CLIENT_ID=quantos-terminal-desktop
NEXT_PUBLIC_QUANTOS_DEFAULT_MODE=paper
NEXT_PUBLIC_QUANTOS_FEATURE_ASSISTED_LIVE_TESTNET=off
NEXT_PUBLIC_QUANTOS_OBS_ENABLED=false
NEXT_PUBLIC_QUANTOS_SENTRY_DSN=
