# QuantOS 前端环境：local-integrated（PRE-05）
# 用途：本地前端对接本机运行的真实 BFF/领域服务（联调用）。
# 使用：cp env/local-integrated.env.example apps/terminal/.env.local && pnpm --filter @sumalpha/terminal dev

NEXT_PUBLIC_QUANTOS_ENV=local-integrated
NEXT_PUBLIC_QUANTOS_MOCK_ENABLED=false

# 本机 BFF（Gateway/BFF 本地实例；浏览器不直连 Supabase/NATS/Engine/venue）
NEXT_PUBLIC_QUANTOS_BFF_ORIGIN=http://localhost:8080

# 本机 OIDC（开发 IdP 或 staging IdP 的本地回调注册）
NEXT_PUBLIC_QUANTOS_OIDC_ISSUER=https://your-dev-idp.example.com
NEXT_PUBLIC_QUANTOS_OIDC_CLIENT_ID=quantos-terminal-local
NEXT_PUBLIC_QUANTOS_OIDC_REDIRECT_URI=http://localhost:3100/auth/callback

NEXT_PUBLIC_QUANTOS_DEFAULT_MODE=paper
NEXT_PUBLIC_QUANTOS_FEATURE_ASSISTED_LIVE_TESTNET=off

NEXT_PUBLIC_QUANTOS_OBS_ENABLED=false
NEXT_PUBLIC_QUANTOS_SENTRY_DSN=
