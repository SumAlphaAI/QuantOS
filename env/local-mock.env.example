# QuantOS 前端环境：local/mock（PRE-05）
# 用途：本地配置准备；普通 dev 尚未注册 MSW worker，不能保证全部请求离线。
# 使用：cp env/local-mock.env.example apps/terminal/.env.local && pnpm --filter @sumalpha/terminal dev
# 校验：node packages/config/scripts/check-env.mjs <file>

NEXT_PUBLIC_QUANTOS_ENV=local-mock
NEXT_PUBLIC_QUANTOS_MOCK_ENABLED=true

# Web origins：官网与 Terminal 分应用运行；OIDC callback 必须与 Terminal 同源
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_QUANTOS_TERMINAL_ORIGIN=http://localhost:3100

# BFF origin 供页面配置使用；自动化测试可用 route/fixture 拦截，普通 dev 不保证拦截。
NEXT_PUBLIC_QUANTOS_BFF_ORIGIN=http://localhost:4010

# OIDC：此占位 issuer 仅供带拦截的测试；普通 dev 的登录会尝试跳转该 origin。
# 离线 UI 可查看静态/fixture 页面；认证 PoC 请运行 tests/e2e/auth-callback.spec.ts。
NEXT_PUBLIC_QUANTOS_OIDC_ISSUER=https://mock.idp.local
NEXT_PUBLIC_QUANTOS_OIDC_CLIENT_ID=quantos-terminal-local
NEXT_PUBLIC_QUANTOS_OIDC_REDIRECT_URI=http://localhost:3100/auth/callback

# 运行模式（与部署环境分离）：仅 research/paper/shadow
NEXT_PUBLIC_QUANTOS_DEFAULT_MODE=paper

# M5 testnet 条件入口：默认 off；on 也需服务端 flag/capability 放行（L03）
NEXT_PUBLIC_QUANTOS_FEATURE_ASSISTED_LIVE_TESTNET=off

# 观测：本地默认关闭
NEXT_PUBLIC_QUANTOS_OBS_ENABLED=false
NEXT_PUBLIC_QUANTOS_SENTRY_DSN=
