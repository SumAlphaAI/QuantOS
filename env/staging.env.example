# QuantOS 前端环境：staging（PRE-05）
# 用途：staging 部署/验收。校验强制：禁 mock、BFF 与 OIDC callback 必须 https、观测开启时必须配 DSN。
# 注意：本文件只含公开值；server secret（service role、venue key、模型 key）永不进入本文件与客户端 bundle。

NEXT_PUBLIC_QUANTOS_ENV=staging
NEXT_PUBLIC_QUANTOS_MOCK_ENABLED=false

NEXT_PUBLIC_SITE_ORIGIN=https://staging.sumalpha.ai
NEXT_PUBLIC_QUANTOS_TERMINAL_ORIGIN=https://app.staging.sumalpha.ai

NEXT_PUBLIC_QUANTOS_BFF_ORIGIN=https://bff.staging.sumalpha.ai

NEXT_PUBLIC_QUANTOS_OIDC_ISSUER=https://idp.staging.sumalpha.ai
NEXT_PUBLIC_QUANTOS_OIDC_CLIENT_ID=quantos-terminal-staging
NEXT_PUBLIC_QUANTOS_OIDC_REDIRECT_URI=https://app.staging.sumalpha.ai/auth/callback

NEXT_PUBLIC_QUANTOS_DEFAULT_MODE=paper
# M5 评审准备期间可由发布单显式置 on；仍需服务端 flag/capability 放行（L03）
NEXT_PUBLIC_QUANTOS_FEATURE_ASSISTED_LIVE_TESTNET=off

# 观测（按隐私策略启用）：Sentry 使用公网 DSN，token/密钥/完整敏感载荷不上报
NEXT_PUBLIC_QUANTOS_OBS_ENABLED=true
NEXT_PUBLIC_QUANTOS_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# E2E 测试账号标识（仅测试运行器使用，非 secret，不进入 bundle；口令存 CI secret）
# 这些是保留格式的占位标识，不代表账号已创建；真实 staging 身份由受控环境注入。
QUANTOS_E2E_ACCOUNT_RESEARCHER=e2e-researcher@staging.sumalpha.ai
QUANTOS_E2E_ACCOUNT_TRADER=e2e-trader@staging.sumalpha.ai
QUANTOS_E2E_ACCOUNT_APPROVER=e2e-approver@staging.sumalpha.ai
QUANTOS_E2E_ACCOUNT_ADMIN=e2e-admin@staging.sumalpha.ai
