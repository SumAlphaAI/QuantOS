{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantos.sumalpha.ai/schemas/bff/1.3.0/components.json",
  "title": "QuantOS Terminal BFF API component schemas",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid"
    },
    "DateTime": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC"
    },
    "DecimalValue": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "十进制定点字符串（proto DecimalValue.value；禁 IEEE-754 交易计算）"
    },
    "MoneyValue": {
      "type": "object",
      "required": [
        "currencyCode",
        "units",
        "nanos"
      ],
      "properties": {
        "currencyCode": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "units": {
          "type": "string",
          "format": "int64"
        },
        "nanos": {
          "type": "integer",
          "minimum": -999999999,
          "maximum": 999999999
        }
      }
    },
    "RuntimeMode": {
      "type": "string",
      "enum": [
        "research",
        "paper",
        "shadow",
        "assisted_live"
      ],
      "description": "assisted_live 仅 M5+ 且服务端 flag/capability 放行才可见；客户端不得硬编码可用性"
    },
    "Environment": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "DataQuality": {
      "type": "string",
      "enum": [
        "verified",
        "provisional",
        "degraded",
        "failed",
        "expired",
        "license_missing"
      ],
      "description": "未知值客户端显示\"未知/需升级\"并阻断高风险动作"
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "cancel_requested"
      ]
    },
    "OrderStatus": {
      "type": "string",
      "enum": [
        "draft",
        "risk_checking",
        "awaiting_approval",
        "command_ready",
        "submitted",
        "accepted",
        "partially_filled",
        "filled",
        "cancelled",
        "rejected",
        "expired"
      ]
    },
    "TimeWindow": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/DateTime"
        },
        "end": {
          "$ref": "#/$defs/DateTime"
        }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "required": [
        "code",
        "message",
        "correlationId"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "稳定机器码，如 FORBIDDEN/VERSION_CONFLICT/COMMAND_EXPIRED/DATA_STALE"
        },
        "message": {
          "type": "string",
          "description": "安全可展示文案（i18n key 由客户端映射）"
        },
        "correlationId": {
          "$ref": "#/$defs/UUID"
        },
        "fieldErrors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "retryAfter": {
          "type": "integer",
          "minimum": 0,
          "description": "秒"
        },
        "currentVersion": {
          "type": "string",
          "description": "409 时返回，供客户端 diff"
        }
      }
    },
    "Page": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {}
        },
        "nextCursor": {
          "type": "string",
          "description": "缺省表示末页"
        }
      }
    },
    "AsyncAccepted": {
      "type": "object",
      "required": [
        "jobId",
        "status",
        "correlationId"
      ],
      "properties": {
        "jobId": {
          "$ref": "#/$defs/UUID"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "cancel_requested"
          ]
        },
        "correlationId": {
          "$ref": "#/$defs/UUID"
        }
      }
    },
    "AuditedAsyncAccepted": {
      "allOf": [
        {
          "$ref": "#/$defs/AsyncAccepted"
        },
        {
          "type": "object",
          "required": [
            "auditRef"
          ],
          "properties": {
            "auditRef": {
              "$ref": "#/$defs/UUID"
            }
          }
        }
      ]
    },
    "ReauthRequest": {
      "type": "object",
      "required": [
        "challengeRef"
      ],
      "properties": {
        "challengeRef": {
          "$ref": "#/$defs/UUID"
        }
      },
      "additionalProperties": false
    },
    "StreamEvent": {
      "type": "object",
      "required": [
        "streamId",
        "sequence",
        "eventId",
        "occurredAt",
        "correlationId",
        "payloadVersion",
        "payload"
      ],
      "properties": {
        "streamId": {
          "$ref": "#/$defs/UUID"
        },
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "eventId": {
          "$ref": "#/$defs/UUID"
        },
        "occurredAt": {
          "$ref": "#/$defs/DateTime"
        },
        "correlationId": {
          "$ref": "#/$defs/UUID"
        },
        "payloadVersion": {
          "type": "string",
          "description": "载荷 schema 版本（未知版本客户端 fail closed）"
        },
        "payload": {
          "type": "object",
          "description": "领域事件载荷；payload.type=permission_revoked 为终态语义"
        }
      }
    },
    "SessionContext": {
      "type": "object",
      "required": [
        "actorId",
        "tenantId",
        "workspaceId",
        "accountId",
        "mode",
        "environment",
        "capabilities",
        "mfaState",
        "expiresAt"
      ],
      "properties": {
        "actorId": {
          "$ref": "#/$defs/UUID"
        },
        "tenantId": {
          "$ref": "#/$defs/UUID"
        },
        "workspaceId": {
          "$ref": "#/$defs/UUID"
        },
        "accountId": {
          "$ref": "#/$defs/UUID"
        },
        "mode": {
          "$ref": "#/$defs/RuntimeMode"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "capability key 全集（权限裁剪唯一来源）"
        },
        "mfaState": {
          "type": "string",
          "enum": [
            "unenrolled",
            "enrolled",
            "challenged",
            "verified"
          ]
        },
        "expiresAt": {
          "$ref": "#/$defs/DateTime"
        }
      }
    },
    "ProfileSettingsInput": {
      "type": "object",
      "required": [
        "displayName",
        "locale",
        "timezone",
        "theme",
        "numberFormat",
        "timeDisplay",
        "defaultRoute",
        "density",
        "highContrast",
        "reducedMotion"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "team": {
          "type": "string",
          "maxLength": 120
        },
        "locale": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en"
          ]
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone"
        },
        "theme": {
          "type": "string",
          "enum": [
            "system",
            "dark",
            "light"
          ]
        },
        "numberFormat": {
          "type": "string",
          "enum": [
            "comma_dot",
            "space_comma"
          ]
        },
        "timeDisplay": {
          "type": "string",
          "enum": [
            "utc_local",
            "local"
          ]
        },
        "defaultRoute": {
          "type": "string",
          "enum": [
            "/command",
            "/research",
            "/portfolio",
            "/markets"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "comfortable"
          ]
        },
        "highContrast": {
          "type": "boolean"
        },
        "reducedMotion": {
          "type": "boolean"
        }
      }
    },
    "ProfileSettings": {
      "allOf": [
        {
          "$ref": "#/$defs/ProfileSettingsInput"
        },
        {
          "type": "object",
          "required": [
            "memberId",
            "email",
            "emailVerified",
            "roleLabels",
            "objectVersion"
          ],
          "properties": {
            "memberId": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email",
              "readOnly": true
            },
            "emailVerified": {
              "type": "boolean",
              "readOnly": true
            },
            "roleLabels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "readOnly": true
            },
            "objectVersion": {
              "type": "string"
            }
          }
        }
      ]
    },
    "NotificationRule": {
      "type": "object",
      "required": [
        "key",
        "severity",
        "inApp",
        "desktop",
        "email",
        "browser"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "warning",
            "info"
          ]
        },
        "inApp": {
          "type": "boolean"
        },
        "desktop": {
          "type": "boolean"
        },
        "email": {
          "type": "boolean"
        },
        "browser": {
          "type": "boolean"
        }
      }
    },
    "NotificationPreferencesInput": {
      "type": "object",
      "required": [
        "rules",
        "quietHoursEnabled",
        "quietHoursStart",
        "quietHoursEnd",
        "criticalBypass",
        "digestFrequency"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotificationRule"
          }
        },
        "quietHoursEnabled": {
          "type": "boolean"
        },
        "quietHoursStart": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "quietHoursEnd": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "criticalBypass": {
          "type": "boolean",
          "description": "Critical 可绕过静默但仍受服务端授权策略约束"
        },
        "digestFrequency": {
          "type": "string",
          "enum": [
            "off",
            "daily",
            "weekly"
          ]
        }
      }
    },
    "NotificationPreferences": {
      "allOf": [
        {
          "$ref": "#/$defs/NotificationPreferencesInput"
        },
        {
          "type": "object",
          "required": [
            "objectVersion",
            "browserPermission"
          ],
          "properties": {
            "objectVersion": {
              "type": "string"
            },
            "browserPermission": {
              "type": "string",
              "enum": [
                "granted",
                "denied",
                "default",
                "unsupported"
              ]
            }
          }
        }
      ]
    },
    "MfaFactor": {
      "type": "object",
      "required": [
        "factorId",
        "method",
        "label",
        "createdAt",
        "lastUsedAt",
        "currentDevice"
      ],
      "properties": {
        "factorId": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "passkey",
            "authenticator",
            "recovery_codes"
          ]
        },
        "label": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/DateTime"
        },
        "lastUsedAt": {
          "$ref": "#/$defs/DateTime"
        },
        "currentDevice": {
          "type": "boolean"
        }
      }
    },
    "SecuritySettings": {
      "type": "object",
      "required": [
        "posture",
        "score",
        "mfaEnabled",
        "factors",
        "recoveryCodesRemaining",
        "lastVerifiedAt",
        "correlationId"
      ],
      "properties": {
        "posture": {
          "type": "string",
          "enum": [
            "strong",
            "attention_required",
            "unknown"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "mfaEnabled": {
          "type": "boolean"
        },
        "factors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MfaFactor"
          }
        },
        "recoveryCodesRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "lastVerifiedAt": {
          "$ref": "#/$defs/DateTime"
        },
        "correlationId": {
          "$ref": "#/$defs/UUID"
        }
      }
    },
    "ActiveSession": {
      "type": "object",
      "required": [
        "sessionId",
        "client",
        "platform",
        "location",
        "lastActiveAt",
        "ipMasked",
        "current"
      ],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "lastActiveAt": {
          "$ref": "#/$defs/DateTime"
        },
        "ipMasked": {
          "type": "string",
          "description": "仅脱敏 IP，禁止返回完整地址"
        },
        "current": {
          "type": "boolean"
        }
      }
    },
    "TrustedDevice": {
      "type": "object",
      "required": [
        "deviceId",
        "label",
        "verificationMethod",
        "trustedUntil",
        "current"
      ],
      "properties": {
        "deviceId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "verificationMethod": {
          "type": "string",
          "enum": [
            "passkey",
            "biometric",
            "authenticator"
          ]
        },
        "trustedUntil": {
          "$ref": "#/$defs/DateTime"
        },
        "current": {
          "type": "boolean"
        }
      }
    },
    "DownloadRecord": {
      "type": "object",
      "required": [
        "downloadId",
        "objectLabel",
        "format",
        "requestedAt",
        "status"
      ],
      "properties": {
        "downloadId": {
          "type": "string"
        },
        "objectLabel": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "requestedAt": {
          "$ref": "#/$defs/DateTime"
        },
        "status": {
          "type": "string",
          "enum": [
            "preparing",
            "ready",
            "downloaded",
            "expired",
            "failed"
          ]
        },
        "expiresAt": {
          "$ref": "#/$defs/DateTime"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "description": "BFF 短时签名 URL；不得写入日志或持久化"
        },
        "watermarked": {
          "type": "boolean"
        },
        "correlationId": {
          "$ref": "#/$defs/UUID"
        }
      }
    },
    "BrowserCapabilityPolicy": {
      "type": "object",
      "required": [
        "kind",
        "authFlow",
        "notifications",
        "localFileImport",
        "deepLinkScheme",
        "downloadsViaBff",
        "offlineDomainActions",
        "businessPagesNoIndex",
        "cspEnforced",
        "sessionProtected"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "web"
          ]
        },
        "authFlow": {
          "type": "string",
          "enum": [
            "browser_redirect"
          ]
        },
        "notifications": {
          "type": "string",
          "enum": [
            "browser"
          ]
        },
        "localFileImport": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "deepLinkScheme": {
          "type": "string",
          "format": "uri"
        },
        "downloadsViaBff": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "offlineDomainActions": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "businessPagesNoIndex": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "cspEnforced": {
          "type": "boolean"
        },
        "sessionProtected": {
          "type": "boolean"
        }
      }
    },
    "AuditEvent": {
      "type": "object",
      "required": [
        "eventId",
        "correlationId",
        "sequence",
        "kind",
        "actor",
        "objectRef",
        "occurredAt",
        "redactionApplied",
        "redactedPayload",
        "payloadHash",
        "retentionUntil"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/UUID"
        },
        "correlationId": {
          "$ref": "#/$defs/UUID"
        },
        "causationId": {
          "$ref": "#/$defs/UUID"
        },
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "kind": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "description": "已脱敏的 actor 显示名或服务主体"
        },
        "objectRef": {
          "type": "string"
        },
        "occurredAt": {
          "$ref": "#/$defs/DateTime"
        },
        "redactionApplied": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "redactedPayload": {
          "type": "object",
          "additionalProperties": true,
          "description": "只允许服务端脱敏后输出；密钥、token、完整账户标识禁止出现"
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "retentionUntil": {
          "$ref": "#/$defs/DateTime"
        }
      }
    },
    "AuditEventPage": {
      "allOf": [
        {
          "$ref": "#/$defs/Page"
        },
        {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AuditEvent"
              }
            }
          }
        }
      ]
    },
    "EvidenceNode": {
      "type": "object",
      "required": [
        "eventId",
        "sequence",
        "kind",
        "objectRef",
        "occurredAt",
        "payloadHash",
        "route",
        "retentionUntil"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/UUID"
        },
        "causationId": {
          "$ref": "#/$defs/UUID"
        },
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "kind": {
          "type": "string"
        },
        "objectRef": {
          "type": "string"
        },
        "occurredAt": {
          "$ref": "#/$defs/DateTime"
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "route": {
          "type": "string",
          "pattern": "^/",
          "description": "只含资源引用，不含 token"
        },
        "retentionUntil": {
          "$ref": "#/$defs/DateTime"
        }
      }
    },
    "EvidenceChainPage": {
      "type": "object",
      "required": [
        "correlationId",
        "items",
        "complete"
      ],
      "properties": {
        "correlationId": {
          "$ref": "#/$defs/UUID"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceNode"
          }
        },
        "nextCursor": {
          "type": "string"
        },
        "complete": {
          "type": "boolean",
          "description": "true 仅表示当前授权范围内证据链完整"
        }
      }
    },
    "ExportScope": {
      "type": "object",
      "required": [
        "correlationIds"
      ],
      "properties": {
        "correlationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/UUID"
          }
        },
        "eventKinds": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "startAt": {
          "$ref": "#/$defs/DateTime"
        },
        "endAt": {
          "$ref": "#/$defs/DateTime"
        }
      },
      "additionalProperties": false
    },
    "ExportRequest": {
      "type": "object",
      "required": [
        "scope",
        "format",
        "reason",
        "watermark",
        "retentionDays"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/ExportScope"
        },
        "format": {
          "type": "string",
          "enum": [
            "jsonl",
            "csv",
            "pdf"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        },
        "watermark": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "additionalProperties": false
    },
    "ExportJob": {
      "type": "object",
      "required": [
        "exportId",
        "status",
        "format",
        "requestedBy",
        "requestedAt",
        "watermark",
        "retentionUntil",
        "correlationId",
        "auditRef"
      ],
      "properties": {
        "exportId": {
          "$ref": "#/$defs/UUID"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "generating",
            "ready",
            "cancel_requested",
            "cancelled",
            "expired",
            "failed"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "jsonl",
            "csv",
            "pdf"
          ]
        },
